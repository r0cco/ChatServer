# ==========================================
# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains / IntelliJ / Erlang plugin
.idea/
*.iws
*.iml
*.ipr

# Emacs & Vim swap files
*~
*.swp
*.swo

# ==========================================
# Environment & Local Overrides
# ==========================================
