# ==========================================
# Erlang & Rebar3 Build Artifacts
# ==========================================
# Downloaded dependencies, compiled beams, and releases
_build/
_checkouts/

# Rebar3 lock file (Optional: KEEP tracked for reproducible builds)
# rebar.lock

# Crash dumps and logs from the Erlang VM
erl_crash.dump
*.dump
*.log

# Mnesia database files (if used later for chat persistence)
Mnesia.*/
mnesia/

